ath10k: drop WCN3990 channel info events without a frequency.
From moWerk/sailfishos-pro1x-mainline kernel/patches-7.3 (0031).

diff --git a/drivers/net/wireless/ath/ath10k/wmi.c b/drivers/net/wireless/ath/ath10k/wmi.c
index e57588c19..adc9c62b0 100644
--- a/drivers/net/wireless/ath/ath10k/wmi.c
+++ b/drivers/net/wireless/ath/ath10k/wmi.c
@@ -2733,6 +2733,12 @@ static void ath10k_wmi_event_chan_info_unpaired(struct ath10k *ar,
 		return;
 	}
 
+	/* WCN3990 firmware reports channel info without a channel during scans */
+	if (!params->freq) {
+		ath10k_dbg(ar, ATH10K_DBG_WMI, "chan info without frequency\n");
+		return;
+	}
+
 	idx = freq_to_idx(ar, params->freq);
 	if (idx >= ARRAY_SIZE(ar->survey)) {
 		ath10k_warn(ar, "chan info: invalid frequency %d (idx %d out of bounds)\n",
@@ -2764,6 +2770,12 @@ static void ath10k_wmi_event_chan_info_paired(struct ath10k *ar,
 	struct survey_info *survey;
 	int idx;
 
