diff --git a/drivers/power/supply/pro1x-adc-battery.c b/drivers/power/supply/pro1x-adc-battery.c
new file mode 100644
index 000000000..e7eada49d
--- /dev/null
+++ b/drivers/power/supply/pro1x-adc-battery.c
@@ -0,0 +1,284 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Voltage-only battery estimate from PMIC ADC channels.
+ *
+ * For boards without a mainline fuel gauge / charger driver (F(x)tec Pro1X: the
+ * PMI632 "smb5" charger and "QG" gauge). Reads the battery voltage and the USB
+ * input voltage through IIO, derives the state of charge from the open-circuit
+ * voltage table of the monitored simple-battery node, and reports charging /
+ * discharging / full from the USB input voltage. It is an estimate: the voltage
+ * sags under load and rises while charging, so a fixed offset can be applied
+ * while a charger is present.
+ */
+#include <linux/delay.h>
+#include <linux/devm-helpers.h>
+#include <linux/iio/consumer.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/property.h>
+
+#define POLL_MS			30000
+
+/* Voltage rise (uV) attributed to the charge current while a charger is in; tunable live. */
+static unsigned int charge_offset_uv = 40000;
+module_param(charge_offset_uv, uint, 0644);
+MODULE_PARM_DESC(charge_offset_uv, "Subtracted from the battery voltage while USB is present (uV)");
+#define USB_PRESENT_UV		4000000
+
+struct adc_battery {
+	struct device *dev;
+	struct power_supply *psy;
+	struct power_supply_battery_info *info;
+	struct iio_channel *vbat;
+	struct iio_channel *usbin;
+	struct delayed_work work;
+	struct mutex lock;
+	u32 full_uv;
+	int cap;		/* cached, slew-limited estimate (%) */
+	int status;
+};
+
+/* IIO "processed" values of the SPMI ADC are in micro-units for voltages. */
+static int adc_read_uv(struct iio_channel *chan, int *uv)
+{
+	int ret = iio_read_channel_processed_scale(chan, uv, 1);
+
+	return ret < 0 ? ret : 0;
+}
+
+#define BURST		8
+#define BURST_PICK	5	/* of 8, ascending: ignores the lowest (sagging) samples */
+
+static int adc_battery_sample(struct adc_battery *b, int *vbat, bool *usb)
+{
+	int v[BURST], usbin, ret, i, j, t;
+
+	for (i = 0; i < BURST; i++) {
+		ret = adc_read_uv(b->vbat, &v[i]);
+		if (ret)
+			return ret;
+		if (i < BURST - 1)
+			usleep_range(5000, 8000);
+	}
+	/* insertion sort, ascending */
+	for (i = 1; i < BURST; i++)
+		for (j = i; j > 0 && v[j - 1] > v[j]; j--) {
+			t = v[j]; v[j] = v[j - 1]; v[j - 1] = t;
+		}
+	*vbat = v[BURST_PICK];
+
+	ret = adc_read_uv(b->usbin, &usbin);
+	if (ret)
+		return ret;
+
+	*usb = usbin > USB_PRESENT_UV;
+	return 0;
+}
+
+static int adc_battery_status(struct adc_battery *b, int vbat, bool usb)
+{
+	if (!usb)
+		return POWER_SUPPLY_STATUS_DISCHARGING;
+	if (vbat >= b->full_uv)
+		return POWER_SUPPLY_STATUS_FULL;
+	return POWER_SUPPLY_STATUS_CHARGING;
+}
+
+/* Raw estimate from one sample; b->lock held by callers that update b->cap. */
+static int adc_battery_estimate(struct adc_battery *b, int vbat, bool usb)
+{
+	int ocv = vbat, cap;
+
+	if (usb && ocv > (int)charge_offset_uv)
+		ocv -= charge_offset_uv;
+
+	cap = power_supply_batinfo_ocv2cap(b->info, ocv, 25);
+	if (cap < 0)
+		return cap;
+	cap = clamp(cap, 0, 100);
+
+	if (usb && vbat >= b->full_uv)
+		cap = 100;
+	return cap;
+}
+
+/* Move the cached value towards the estimate by at most 1 % per update. */
+static void adc_battery_update(struct adc_battery *b)
+{
+	bool usb;
+	int vbat, est;
+
+	if (adc_battery_sample(b, &vbat, &usb))
+		return;
+	est = adc_battery_estimate(b, vbat, usb);
+	if (est < 0)
+		return;
+
+	mutex_lock(&b->lock);
+	if (b->cap < 0 || est == 100 || est == 0)
+		b->cap = est;
+	else if (est > b->cap)
+		b->cap++;
+	else if (est < b->cap)
+		b->cap--;
+	b->status = adc_battery_status(b, vbat, usb);
+	mutex_unlock(&b->lock);
+}
+
+static int adc_battery_get_property(struct power_supply *psy,
+				    enum power_supply_property psp,
+				    union power_supply_propval *val)
+{
+	struct adc_battery *b = power_supply_get_drvdata(psy);
+	bool usb;
+	int vbat, cap, status, ret;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = 1;
+		return 0;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
+	case POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN:
+	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+		if (power_supply_battery_info_has_prop(b->info, psp))
+			return power_supply_battery_info_get_prop(b->info, psp, val);
+		return -EINVAL;
+	default:
+		break;
+	}
+
+	mutex_lock(&b->lock);
+	cap = b->cap;
+	status = b->status;
+	mutex_unlock(&b->lock);
+	if (cap < 0)
+		return -ENODATA;
+
+	if (psp == POWER_SUPPLY_PROP_VOLTAGE_NOW) {
+		ret = adc_battery_sample(b, &vbat, &usb);
+		if (ret)
+			return ret;
+		val->intval = vbat;
+		return 0;
+	}
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_STATUS:
+		val->intval = status;
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		val->intval = cap;
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY_LEVEL:
+		if (cap >= 100)
+			val->intval = POWER_SUPPLY_CAPACITY_LEVEL_FULL;
+		else if (cap > 15)
+			val->intval = POWER_SUPPLY_CAPACITY_LEVEL_NORMAL;
+		else if (cap > 5)
+			val->intval = POWER_SUPPLY_CAPACITY_LEVEL_LOW;
+		else
+			val->intval = POWER_SUPPLY_CAPACITY_LEVEL_CRITICAL;
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static const enum power_supply_property adc_battery_props[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN,
+	POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN,
+	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_CAPACITY_LEVEL,
+};
+
+static const struct power_supply_desc adc_battery_desc = {
+	.name = "battery",
+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = adc_battery_props,
+	.num_properties = ARRAY_SIZE(adc_battery_props),
+	.get_property = adc_battery_get_property,
+};
+
+static void adc_battery_poll(struct work_struct *work)
+{
+	struct adc_battery *b = container_of(work, struct adc_battery, work.work);
+
+	adc_battery_update(b);
+	power_supply_changed(b->psy);
+	schedule_delayed_work(&b->work, msecs_to_jiffies(POLL_MS));
+}
+
+static int adc_battery_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct power_supply_config cfg = { };
+	struct adc_battery *b;
+	int ret;
+
+	b = devm_kzalloc(dev, sizeof(*b), GFP_KERNEL);
+	if (!b)
+		return -ENOMEM;
+	b->dev = dev;
+	b->cap = -1;
+	b->status = POWER_SUPPLY_STATUS_UNKNOWN;
+	mutex_init(&b->lock);
+
+	b->vbat = devm_iio_channel_get(dev, "vbat");
+	if (IS_ERR(b->vbat))
+		return dev_err_probe(dev, PTR_ERR(b->vbat), "vbat channel\n");
+	b->usbin = devm_iio_channel_get(dev, "usbin");
+	if (IS_ERR(b->usbin))
+		return dev_err_probe(dev, PTR_ERR(b->usbin), "usbin channel\n");
+
+	b->full_uv = 4380000;
+	device_property_read_u32(dev, "fxtec,full-voltage-microvolt", &b->full_uv);
+
+	cfg.drv_data = b;
+	cfg.fwnode = dev_fwnode(dev);
+	b->psy = devm_power_supply_register(dev, &adc_battery_desc, &cfg);
+	if (IS_ERR(b->psy))
+		return PTR_ERR(b->psy);
+
+	ret = power_supply_get_battery_info(b->psy, &b->info);
+	if (ret)
+		return dev_err_probe(dev, ret, "monitored-battery info\n");
+	if (!b->info->ocv_table[0])
+		return dev_err_probe(dev, -EINVAL, "battery has no ocv-capacity-table\n");
+
+	ret = devm_delayed_work_autocancel(dev, &b->work, adc_battery_poll);
+	if (ret)
+		return ret;
+	adc_battery_update(b);
+	schedule_delayed_work(&b->work, msecs_to_jiffies(POLL_MS));
+	return 0;
+}
+
+static const struct of_device_id adc_battery_of_match[] = {
+	{ .compatible = "fxtec,pro1x-adc-battery" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, adc_battery_of_match);
+
+static struct platform_driver adc_battery_driver = {
+	.probe = adc_battery_probe,
+	.driver = {
+		.name = "pro1x-adc-battery",
+		.of_match_table = adc_battery_of_match,
+	},
+};
+module_platform_driver(adc_battery_driver);
+
+MODULE_DESCRIPTION("Voltage-based battery estimate from PMIC ADC (Pro1X)");
+MODULE_LICENSE("GPL");
diff --git a/drivers/power/supply/pro1x-charger-icl.c b/drivers/power/supply/pro1x-charger-icl.c
new file mode 100644
index 000000000..b68dc24b6
--- /dev/null
+++ b/drivers/power/supply/pro1x-charger-icl.c
@@ -0,0 +1,242 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * USB input current limit for the PMI632 "smb5" charger (F(x)tec Pro1X).
+ *
+ * There is no mainline PMI632 charger driver. The hardware charges the
+ * battery on its own, but its input current limit comes from battery-charger
+ * detection (APSD) and stays at the USB default of 500 mA unless software
+ * raises it, which Android's smb5 driver does for dedicated chargers and for
+ * Type-C sources that advertise 1.5/3 A. This driver does the same, and only
+ * that: it never lowers anything and never touches the charge current or
+ * voltage settings.
+ *
+ * Register names and layout follow the vendor smb5 headers.
+ */
+
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+
+#define ICL_MAX_STATUS		0x106	/* DCDC base + 0x06 (relative to 0x1000) */
+#define CHGR_STATUS_1		0x006
+#define  CHGR_STATE_MASK	GENMASK(2, 0)
+#define  CHGR_STATE_DISABLED	7
+#define CHGR_ENABLE_CMD		0x042
+#define  CHGR_ENABLE		BIT(0)
+#define WDOG_PET		0x643	/* MISC base 0x600 + 0x43 */
+#define  WDOG_PET_BIT		BIT(0)
+#define WD_CFG			0x651
+#define SNARL_BARK_BITE_CFG	0x653
+#define DCDC_ICL_STATUS		0x107
+#define POWER_PATH_STATUS	0x10b
+#define  USE_USBIN		BIT(4)
+#define APSD_RESULT_STATUS	0x308
+#define  APSD_DCP		BIT(3)
+#define  APSD_CDP		BIT(2)
+#define  APSD_QC2		BIT(5)
+#define  APSD_QC3		BIT(6)
+#define CMD_ICL_OVERRIDE	0x342
+#define  ICL_OVERRIDE		BIT(0)
+#define USBIN_ICL_OPTIONS	0x366
+#define  USB51_MODE		BIT(1)
+#define  USBIN_MODE_CHG		BIT(0)
+#define USBIN_CURRENT_LIMIT_CFG	0x370
+#define TYPE_C_SNK_STATUS	0x506
+#define  SNK_RP_1P5		(BIT(2) | BIT(5))
+#define  SNK_RP_3P0		(BIT(1) | BIT(4))
+
+#define ICL_STEP_UA		50000
+#define POLL_MS			2000
+
+static unsigned int max_icl_ma = 1500;
+module_param(max_icl_ma, uint, 0644);
+MODULE_PARM_DESC(max_icl_ma, "Highest USB input current limit to set in mA (0 = do nothing)");
+
+static unsigned int min_icl_ma;
+module_param(min_icl_ma, uint, 0644);
+MODULE_PARM_DESC(min_icl_ma, "Raise the input limit to at least this (mA) on any source, even one detected as plain USB (0 = off). The chip's AICL still backs off if the source sags. Never exceeds max_icl_ma.");
+
+static bool pet_wdog = true;
+module_param(pet_wdog, bool, 0644);
+MODULE_PARM_DESC(pet_wdog, "Pet the charger watchdog while USB is present, and re-enable charging if it already bit");
+
+struct pro1x_chg {
+	struct device *dev;
+	struct regmap *map;
+	u32 base;
+	struct delayed_work work;
+	unsigned int applied_ma;	/* what this plug-in already got */
+	bool present;
+	bool recovered;
+	int last_state;
+	unsigned int last_apsd, last_snk, last_icl;
+};
+
+static int rd(struct pro1x_chg *c, unsigned int off, unsigned int *val)
+{
+	return regmap_read(c->map, c->base + off, val);
+}
+
+static unsigned int icl_ma(struct pro1x_chg *c)
+{
+	unsigned int v = 0;
+
+	if (rd(c, DCDC_ICL_STATUS, &v))
+		return 0;
+
+	return v * ICL_STEP_UA / 1000;
+}
+
+static unsigned int wanted_ma(unsigned int apsd, unsigned int snk)
+{
+	unsigned int ma = 0;
+
+	if (apsd & (APSD_DCP | APSD_CDP | APSD_QC2 | APSD_QC3))
+		ma = 1500;
+	if (snk & (SNK_RP_1P5 | SNK_RP_3P0))
+		ma = 1500;
+
+	if (min_icl_ma)
+		ma = max(ma, min_icl_ma);
+
+	return min(ma, max_icl_ma);
+}
+
+static void pro1x_chg_apply(struct pro1x_chg *c, unsigned int ma)
+{
+	unsigned int before = icl_ma(c), after;
+
+	regmap_write(c->map, c->base + USBIN_CURRENT_LIMIT_CFG,
+		     ma * 1000 / ICL_STEP_UA);
+	/* Take the limit from the register above, not the USB 100/500 mA logic. */
+	regmap_update_bits(c->map, c->base + USBIN_ICL_OPTIONS,
+			   USB51_MODE | USBIN_MODE_CHG, USBIN_MODE_CHG);
+	regmap_update_bits(c->map, c->base + CMD_ICL_OVERRIDE,
+			   ICL_OVERRIDE, ICL_OVERRIDE);
+	msleep(200);
+	after = icl_ma(c);
+
+	dev_info(c->dev, "input current limit %u mA -> requested %u mA, now %u mA\n",
+		 before, ma, after);
+}
+
+static void pro1x_chg_work(struct work_struct *w)
+{
+	struct pro1x_chg *c = container_of(to_delayed_work(w), struct pro1x_chg, work);
+	unsigned int pp = 0, apsd = 0, snk = 0, want, icl;
+
+	if (rd(c, POWER_PATH_STATUS, &pp))
+		goto out;
+
+	if (!(pp & USE_USBIN)) {
+		if (c->present)
+			dev_dbg(c->dev, "input removed\n");
+		c->present = false;
+		c->applied_ma = 0;
+		c->recovered = false;
+		c->last_state = -1;
+		goto out;
+	}
+
+	rd(c, APSD_RESULT_STATUS, &apsd);
+	rd(c, TYPE_C_SNK_STATUS, &snk);
+	icl = icl_ma(c);
+	apsd &= 0x7f;
+
+	if (!c->present || apsd != c->last_apsd || snk != c->last_snk || icl != c->last_icl)
+		dev_info(c->dev, "input in: apsd 0x%02x, typec-snk 0x%02x, limit %u mA\n",
+			 apsd, snk, icl);
+	c->present = true;
+	c->last_apsd = apsd;
+	c->last_snk = snk;
+	c->last_icl = icl;
+
+	if (pet_wdog) {
+		unsigned int st = 0, en = 0;
+
+		/* Without this the charger watchdog shuts charging off a few minutes after plug-in. */
+		regmap_write(c->map, c->base + WDOG_PET, WDOG_PET_BIT);
+
+		if (!rd(c, CHGR_STATUS_1, &st)) {
+			st &= CHGR_STATE_MASK;
+			if (st != c->last_state)
+				dev_info(c->dev, "charger state %u\n", st);
+			c->last_state = st;
+			rd(c, CHGR_ENABLE_CMD, &en);
+			if (st == CHGR_STATE_DISABLED && (en & CHGR_ENABLE) && !c->recovered) {
+				c->recovered = true;
+				regmap_update_bits(c->map, c->base + CHGR_ENABLE_CMD, CHGR_ENABLE, 0);
+				msleep(50);
+				regmap_update_bits(c->map, c->base + CHGR_ENABLE_CMD, CHGR_ENABLE, CHGR_ENABLE);
+				dev_info(c->dev, "charging was disabled, toggled enable\n");
+			}
+		}
+	}
+
+	want = wanted_ma(apsd, snk);
+	if (want > icl && want > c->applied_ma) {
+		c->applied_ma = want;
+		pro1x_chg_apply(c, want);
+	}
+out:
+	schedule_delayed_work(&c->work, msecs_to_jiffies(POLL_MS));
+}
+
+static int pro1x_chg_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct pro1x_chg *c;
+	unsigned int wd = 0, wd2 = 0;
+	int ret;
+
+	c = devm_kzalloc(dev, sizeof(*c), GFP_KERNEL);
+	if (!c)
+		return -ENOMEM;
+
+	c->dev = dev;
+	ret = of_property_read_u32(dev->of_node, "reg", &c->base);
+	if (ret)
+		return dev_err_probe(dev, ret, "no base address\n");
+
+	c->map = dev_get_regmap(dev->parent, NULL);
+	if (!c->map)
+		return dev_err_probe(dev, -ENODEV, "no parent regmap\n");
+
+	rd(c, WD_CFG, &wd);
+	rd(c, SNARL_BARK_BITE_CFG, &wd2);
+	dev_info(dev, "watchdog cfg 0x%02x, snarl/bark/bite 0x%02x\n", wd, wd2);
+
+	c->last_state = -1;
+	INIT_DELAYED_WORK(&c->work, pro1x_chg_work);
+	platform_set_drvdata(pdev, c);
+	schedule_delayed_work(&c->work, msecs_to_jiffies(POLL_MS));
+
+	return 0;
+}
+
+static void pro1x_chg_remove(struct platform_device *pdev)
+{
+	cancel_delayed_work_sync(&((struct pro1x_chg *)platform_get_drvdata(pdev))->work);
+}
+
+static const struct of_device_id pro1x_chg_of_match[] = {
+	{ .compatible = "fxtec,pro1x-charger-icl" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, pro1x_chg_of_match);
+
+static struct platform_driver pro1x_chg_driver = {
+	.driver = {
+		.name = "pro1x-charger-icl",
+		.of_match_table = pro1x_chg_of_match,
+	},
+	.probe = pro1x_chg_probe,
+	.remove = pro1x_chg_remove,
+};
+module_platform_driver(pro1x_chg_driver);
+
+MODULE_DESCRIPTION("PMI632 USB input current limit (F(x)tec Pro1X)");
+MODULE_LICENSE("GPL");
