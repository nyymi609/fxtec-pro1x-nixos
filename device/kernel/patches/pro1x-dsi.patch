diff --git a/drivers/gpu/drm/panel/panel-boe-bf060y8m-aj0.c b/drivers/gpu/drm/panel/panel-boe-bf060y8m-aj0.c
index 84c21c62a..9effebea2 100644
--- a/drivers/gpu/drm/panel/panel-boe-bf060y8m-aj0.c
+++ b/drivers/gpu/drm/panel/panel-boe-bf060y8m-aj0.c
@@ -81,6 +81,16 @@ static int boe_bf060y8m_aj0_on(struct boe_bf060y8m_aj0 *boe)
 
 	mipi_dsi_msleep(&dsi_ctx, 30);
 
+	/*
+	 * Out of sleep the panel runs at its power-on brightness until the
+	 * backlight is enabled after this sequence: send the backlight's
+	 * level (0 while it is still disabled) before the display goes on, so
+	 * a wake does not flash bright, dim, then ramp up.
+	 */
+	if (boe->panel.backlight)
+		mipi_dsi_dcs_set_display_brightness_multi(&dsi_ctx,
+				backlight_get_brightness(boe->panel.backlight));
+
 	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
 	mipi_dsi_msleep(&dsi_ctx, 50);
 
@@ -92,16 +102,32 @@ static void boe_bf060y8m_aj0_off(struct boe_bf060y8m_aj0 *boe)
 	struct mipi_dsi_device *dsi = boe->dsi;
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
 
-	/* OFF commands sent in HS mode */
+	/* OFF commands sent in HS mode; display off went out in disable */
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
-	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
-	mipi_dsi_msleep(&dsi_ctx, 20);
-
 	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
 	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
 	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 }
 
+/*
+ * Display off goes out while the host still streams video. Sent from
+ * unprepare, after the stream has stopped, the panel scanned out one
+ * corrupted frame at full brightness before turning off.
+ */
+static int boe_bf060y8m_aj0_disable(struct drm_panel *panel)
+{
+	struct boe_bf060y8m_aj0 *boe = to_boe_bf060y8m_aj0(panel);
+	struct mipi_dsi_device *dsi = boe->dsi;
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return dsi_ctx.accum_err;
+}
+
 static int boe_bf060y8m_aj0_prepare(struct drm_panel *panel)
 {
 	struct boe_bf060y8m_aj0 *boe = to_boe_bf060y8m_aj0(panel);
@@ -168,7 +194,12 @@ static int boe_bf060y8m_aj0_unprepare(struct drm_panel *panel)
 }
 
 static const struct drm_display_mode boe_bf060y8m_aj0_mode = {
-	.clock = 165268,
+	/*
+	 * 1236 x 2192 total at exactly 60 Hz, like the stock mode (stock reports
+	 * fps=60). 165268 kHz made it 61.00 Hz, which made the touchscreen report
+	 * ghost touches (about 5000 events/10 s with the panel on, none at 60 Hz).
+	 */
+	.clock = 162559,
 	.hdisplay = 1080,
 	.hsync_start = 1080 + 36,
 	.hsync_end = 1080 + 36 + 24,
@@ -202,6 +233,7 @@ static int boe_bf060y8m_aj0_get_modes(struct drm_panel *panel,
 
 static const struct drm_panel_funcs boe_bf060y8m_aj0_panel_funcs = {
 	.prepare = boe_bf060y8m_aj0_prepare,
+	.disable = boe_bf060y8m_aj0_disable,
 	.unprepare = boe_bf060y8m_aj0_unprepare,
 	.get_modes = boe_bf060y8m_aj0_get_modes,
 };
@@ -209,9 +241,14 @@ static const struct drm_panel_funcs boe_bf060y8m_aj0_panel_funcs = {
 static int boe_bf060y8m_aj0_bl_update_status(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct boe_bf060y8m_aj0 *boe = mipi_dsi_get_drvdata(dsi);
 	u16 brightness = backlight_get_brightness(bl);
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
 
+	/* the DSI host is off (-EINVAL); boe_bf060y8m_aj0_on() sends the level */
+	if (!boe->panel.prepared)
+		return 0;
+
 	mipi_dsi_dcs_set_display_brightness_multi(&dsi_ctx, brightness);
 
 	return dsi_ctx.accum_err;
@@ -345,8 +382,12 @@ static int boe_bf060y8m_aj0_probe(struct mipi_dsi_device *dsi)
 
 	dsi->lanes = 4;
 	dsi->format = MIPI_DSI_FMT_RGB888;
-	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_NO_EOT_PACKET |
-			  MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
+	/*
+	 * Link settings as in the stock panel node: non-burst with sync events
+	 * (not sync pulses; no VIDEO_SYNC_PULSE flag) and EOT packets appended
+	 * (qcom,mdss-dsi-tx-eot-append; no NO_EOT_PACKET flag).
+	 */
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO |
 			  MIPI_DSI_CLOCK_NON_CONTINUOUS |
 			  MIPI_DSI_MODE_LPM;
 
