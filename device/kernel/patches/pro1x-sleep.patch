+/*
+ * The first two words of the vMPM are its wakeup timer, an absolute arch timer
+ * count. While the CPUs sleep with the GIC off nothing else brings them back for
+ * a kernel timer, so program the earliest hrtimer of the CPUs below this domain
+ * (the CPU governor keeps it in gd->next_hrtimer). During system suspend the
+ * kernel's timers are frozen and only wakeup interrupts count: no timer then.
+ */
+static void mpm_program_wakeup_timer(struct qcom_mpm_priv *priv)
+{
+	struct genpd_governor_data *gd = priv->genpd.gd;
+	u64 ticks = U64_MAX;
+
+	if (gd && pm_suspend_target_state == PM_SUSPEND_ON &&
+	    gd->next_hrtimer != KTIME_MAX) {
+		s64 delta = ktime_to_ns(gd->next_hrtimer) - ktime_get_mono_fast_ns();
+
+		ticks = arch_timer_read_counter();
+		if (delta > 0)
+			ticks += mul_u64_u32_div(delta, arch_timer_get_rate(),
+						 NSEC_PER_SEC);
+	}
+
+	writel_relaxed(lower_32_bits(ticks), priv->base);
+	writel_relaxed(upper_32_bits(ticks), priv->base + 4);
+}
+
