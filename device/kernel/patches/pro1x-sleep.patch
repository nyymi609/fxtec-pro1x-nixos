+/*
+ * An endpoint with a wakeup source (the modem's: qrtr-smd) wakes a suspended
+ * system for a data packet to a user space socket (ModemManager: an
+ * incoming call, an SMS), not for one to a kernel client (IPA's QMI and
+ * the like answered the system going down, and woke it each time).  Off
+ * at run time: /sys/module/qrtr/parameters/wake_on_data.
+ */
+static bool wake_on_data = true;
+module_param(wake_on_data, bool, 0644);
+MODULE_PARM_DESC(wake_on_data, "Data for user space from a wakeup endpoint wakes the system");
+
+/*
+ * When set, only data from these source ports wakes the system: the modem's
+ * network and data services send indications every few seconds (signal,
+ * registration) and kept a suspend from holding; user space lists the ports
+ * of the voice and messaging services (qrtr-lookup).  Empty: any port.
+ */
+static int wake_ports[8];
+static int n_wake_ports;
+module_param_array(wake_ports, int, &n_wake_ports, 0644);
+MODULE_PARM_DESC(wake_ports, "Source ports whose data wakes the system (empty: all)");
+
+static bool qrtr_wake_port(u32 port)
+{
+	int i, n = READ_ONCE(n_wake_ports);
+
+	if (!n)
+		return true;
+	for (i = 0; i < n && i < ARRAY_SIZE(wake_ports); i++)
+		if (READ_ONCE(wake_ports[i]) == port)
+			return true;
+	return false;
+}
